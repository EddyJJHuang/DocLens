# Copy to .env and fill in your keys: cp .env.example .env
OPENAI_API_KEY=your_openai_api_key_here

# Optional: only needed for the multi-LLM evaluation harness (Workstream D).
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model selection
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Paths / CORS
DATA_DIR=./data
FRONTEND_ORIGIN=http://localhost:5173

# Ingestion / retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=10
MAX_SESSION_UPLOADS=5
MAX_SESSION_STORAGE_MB=30
SESSION_TTL_MINUTES=120
MAX_ACTIVE_SESSIONS=100
MAX_QUERY_CHARS=2000
MAX_CONVERSATIONS_PER_SESSION=20
MAX_MESSAGES_PER_CONVERSATION=40
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
